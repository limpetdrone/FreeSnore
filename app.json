{
  "expo": {
    "name": "FreeSnore",
    "slug": "freesnore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "freesnore",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.limpetdrone.freesnore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "A FreeSnore a mikrofont használja a horkolás alvás közbeni érzékeléséhez és elemzéséhez.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.limpetdrone.freesnore",
      "adaptiveIcon": {
        "backgroundColor": "#0c0f1d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "A FreeSnore a mikrofont használja a horkolás alvás közbeni érzékeléséhez és elemzéséhez."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366F1",
          "defaultChannel": "freesnore-tracking"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
