{
  "expo": {
    "name": "FreeSnore",
    "slug": "freesnore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "freesnore",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.limpetdrone.freesnore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "A FreeSnore a mikrofont használja a horkolás alvás közbeni érzékeléséhez és elemzéséhez.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.limpetdrone.freesnore",
      "adaptiveIcon": {
        "backgroundColor": "#0c0f1d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "A FreeSnore a mikrofont használja a horkolás alvás közbeni érzékeléséhez és elemzéséhez.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366F1",
          "defaultChannel": "freesnore-tracking"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A FreeSnore a hozzávetőleges helyed (kb. 10 km) alapján kéri le a környéked pollen- és időjárási adatait. A helyed nem kerül tárolásra.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "A FreeSnore az órád és mérlegeid adatait (pulzus, oxigénszint, alvásszakaszok, súly) olvassa ki, hogy összevesse őket a horkolásoddal. Semmit nem ír az Egészség appba.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "LastNightWidget",
              "displayName": "FreeSnore",
              "description": "Last night's snore score",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LastNight",
              "label": "FreeSnore",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Last night's snore score",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6fff90a7-e6eb-4fa0-a020-fc640219f35e"
      }
    },
    "owner": "limpetdrone",
    "locales": {
      "hu": "./locales/hu.json",
      "en": "./locales/en.json"
    }
  }
}
